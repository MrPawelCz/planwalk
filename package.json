{
  "name": "planwalk",
  "version": "0.3.1",
  "description": "Turn a floor plan into a walkable 3D model: JSON plan format, validator, dollhouse and first-person viewer, GLB export. Made for AI agents and chats with vision.",
  "type": "module",
  "license": "MIT",
  "author": "Paweł Czerwiński (https://github.com/MrPawelCz)",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrPawelCz/planwalk.git"
  },
  "homepage": "https://mrpawelcz.github.io/planwalk/",
  "bugs": {
    "url": "https://github.com/MrPawelCz/planwalk/issues"
  },
  "keywords": ["floor-plan", "3d", "three.js", "llm", "glb", "viewer", "real-estate", "architecture"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/test.mjs",
    "validate": "node tools/validate.mjs",
    "build": "node tools/build.mjs",
    "build:skill": "node tools/build.mjs && node tools/build-skill.mjs",
    "start": "node tools/serve.mjs dist 8080"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.186.1"
  }
}
